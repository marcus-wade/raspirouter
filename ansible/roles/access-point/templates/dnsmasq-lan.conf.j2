# dnsmasq: DHCP + DNS for the LAN side of raspirouter
# (the bridge that carries both the AP and the wired port)
interface={{ lan_bridge }}
# bind-dynamic (not bind-interfaces): br0 members may not all be up when
# dnsmasq starts at boot; bind-dynamic picks the interface up as it appears
bind-dynamic

# DHCP range for clients
dhcp-range={{ ap_dhcp_start }},{{ ap_dhcp_end }},255.255.255.0,24h

# Gateway and DNS pushed to clients
dhcp-option=3,{{ ap_ip }}
dhcp-option=6,{{ ap_ip }}

# Upstream DNS - plain resolvers; campus captive portal intercepts what it needs
server=1.1.1.1
server=9.9.9.9

# Don't read /etc/hosts for clients on this interface
no-hosts

# Lease file
dhcp-leasefile=/var/lib/misc/dnsmasq-lan.leases
