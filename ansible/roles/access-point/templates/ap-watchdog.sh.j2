#!/bin/bash
# raspirouter AP watchdog - the LAN anchor must never fall over.
# Best-effort, idempotent, every minute (via timer). Does NOT touch the
# uplink. START-only on hostapd: restarting a healthy hostapd would kick
# every client off for nothing.
set -u

BR="{{ lan_bridge }}"
AP_IP="{{ ap_ip }}"
changed=0

# 1) The bridge has its static IP?
if ! ip -4 addr show "$BR" 2>/dev/null | grep -q "${AP_IP}/"; then
  logger -t ap-watchdog "$BR missing $AP_IP; reloading systemd-networkd"
  systemctl restart systemd-networkd || true
  changed=1
fi

# 2) hostapd (the AP itself) active?
if ! systemctl is-active --quiet hostapd; then
  logger -t ap-watchdog "hostapd inactive; starting (start, not restart)"
  systemctl start hostapd || true
  changed=1
fi

# 3) dnsmasq (DHCP/DNS for clients) active?
if ! systemctl is-active --quiet dnsmasq; then
  logger -t ap-watchdog "dnsmasq inactive; restarting"
  systemctl restart dnsmasq || true
  changed=1
fi

[ "$changed" = "1" ] && logger -t ap-watchdog "repairs applied to the LAN/AP"
exit 0
