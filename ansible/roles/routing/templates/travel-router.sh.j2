#!/bin/bash
# raspirouter CLI - status and recovery. There are no modes anymore: traffic
# is always NATed directly out {{ uplink_interface }}, and the campus captive
# portal is reachable from any device behind the Pi.
set -u

UPLINK="{{ uplink_interface }}"
AP="{{ ap_interface }}"

need_root() { [ "$(id -u)" = "0" ] || { echo "run with sudo"; exit 1; }; }

ssid() {
  iw dev "$UPLINK" link 2>/dev/null | sed -n 's/^\s*SSID: //p' | head -1
}

status() {
  s="$(ssid)"
  [ -n "$s" ] && echo "uplink     : $s ($(ip -4 -o addr show "$UPLINK" | awk '{print $4}' | head -1))" \
                || echo "uplink     : disconnected"
  if curl -fsS --max-time 4 -o /dev/null http://1.1.1.1 2>/dev/null; then
    echo "internet   : ok"
  else
    echo "internet   : no (captive portal login may be pending - browse any http site from a client)"
  fi
  echo -n "AP hostapd : "; systemctl is-active hostapd
  echo "AP clients : $(iw dev "$AP" station dump 2>/dev/null | grep -c '^Station')"
}

reconnect() {
  need_root
  systemctl restart "wpa_supplicant@${UPLINK}.service"
  sleep 2
  systemctl restart systemd-networkd
  echo "reconnecting $UPLINK... check status in ~15s: sudo travel-router status"
}

case "${1:-}" in
  reconnect) reconnect ;;
  status|"") status ;;
  *) echo "usage: travel-router {status|reconnect}"; exit 1 ;;
esac
